CREATE TABLE IF NOT EXISTS plot (
    id              TEXT    NOT NULL PRIMARY KEY,
    land_id         TEXT    NOT NULL,
    plot_number     TEXT    NOT NULL,
    area_sqft       REAL    NOT NULL,
    status          TEXT    NOT NULL DEFAULT 'available',
    -- status: available | reserved | sold_pending | sold_paid | blocked
    boundary_json   TEXT,   -- GeoJSON polygon stored as TEXT
    price_per_sqft  REAL,
    notes           TEXT,
    created_at      TEXT    NOT NULL,
    updated_at      TEXT    NOT NULL,
    FOREIGN KEY (land_id) REFERENCES land(id) ON DELETE CASCADE
);

selectAllWithBoundary:
SELECT * FROM plot
WHERE boundary_json IS NOT NULL AND boundary_json != ''
ORDER BY land_id, plot_number;

selectByLand:
SELECT * FROM plot WHERE land_id = :land_id ORDER BY plot_number;

selectById:
SELECT * FROM plot WHERE id = :id;

upsert:
INSERT OR REPLACE INTO plot
    (id, land_id, plot_number, area_sqft, status, boundary_json, price_per_sqft, notes, created_at, updated_at)
VALUES
