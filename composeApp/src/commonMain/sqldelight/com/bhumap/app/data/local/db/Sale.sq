CREATE TABLE IF NOT EXISTS sale (
    id              TEXT    NOT NULL PRIMARY KEY,
    plot_id         TEXT    NOT NULL,
    customer_id     TEXT    NOT NULL,
    total_amount    REAL    NOT NULL,
    paid_amount     REAL    NOT NULL DEFAULT 0,
    payment_type    TEXT    NOT NULL DEFAULT 'emi',  -- emi | outright
    emi_months      INTEGER,
    emi_amount      REAL,
    sale_date       TEXT    NOT NULL,
    status          TEXT    NOT NULL DEFAULT 'active',  -- active | completed | cancelled
    notes           TEXT,
    created_at      TEXT    NOT NULL,
    updated_at      TEXT    NOT NULL,
    FOREIGN KEY (plot_id)     REFERENCES plot(id),
    FOREIGN KEY (customer_id) REFERENCES customer(id)
);

selectAll:
SELECT * FROM sale ORDER BY sale_date DESC;

selectById:
SELECT * FROM sale WHERE id = :id;

selectByCustomer:
SELECT * FROM sale WHERE customer_id = :customer_id;

selectByPlot:
SELECT * FROM sale WHERE plot_id = :plot_id LIMIT 1;

upsert:
INSERT OR REPLACE INTO sale
    (id, plot_id, customer_id, total_amount, paid_amount, payment_type, emi_months, emi_amount, sale_date, status, notes, created_at, updated_at)
VALUES
    (:id, :plot_id, :customer_id, :total_amount, :paid_amount, :payment_type, :emi_months, :emi_amount, :sale_date, :status, :notes, :created_at, :updated_at);
