CREATE TABLE IF NOT EXISTS txn (
    id              TEXT    NOT NULL PRIMARY KEY,
    entity_type     TEXT    NOT NULL,  -- farmer | partner | customer
    entity_id       TEXT    NOT NULL,
    sale_id         TEXT,
    amount          REAL    NOT NULL,
    payment_mode    TEXT    NOT NULL,  -- cash | upi | cheque | transfer
    reference_no    TEXT,
    payment_date    TEXT    NOT NULL,
    notes           TEXT,
    created_at      TEXT    NOT NULL
);

selectBySale:
SELECT * FROM txn WHERE sale_id = :sale_id ORDER BY payment_date DESC;

selectByEntity:
SELECT * FROM txn WHERE entity_type = :entity_type AND entity_id = :entity_id ORDER BY payment_date DESC;
